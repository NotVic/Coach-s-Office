# Default stack environment variables for Portainer "Repository" (git-based)
# stack deployments. Portainer requires a file named exactly stack.env to
# already exist in the repo before its Environment Variables UI panel will
# actually apply overrides for this deployment method — without it, values
# typed into that panel are not guaranteed to reach the container.
#
# Override HOST_PORT in Portainer's stack Environment Variables UI if 3000
# is already taken on your server — this file just supplies the default.
# Nothing in this file is secret; CHPP keys and APP_PASSWORD stay out of
# git (see .env.example / README instead).
HOST_PORT=3000
