# Copy this file to .env for local development.
# In Docker/Portainer, set these as stack environment variables instead —
# see README.md's "Deploy with Portainer" section.

# Port the server listens on.
PORT=3000

# Where the SQLite database file lives. The Docker image mounts a volume
# at /app/data, so leave this as-is when running in a container.
DATA_DIR=./data

# Optional: protects the whole app with a single shared password (HTTP
# Basic Auth). Leave blank to disable — fine on a LAN-only home server,
# but set this if the app is ever reachable from the open internet.
APP_PASSWORD=

# CHPP application credentials. Register a CHPP application at
# https://www.hattrick.org/en/Chpp/ to get these — see README.md.
# They can also be entered later from the in-app Settings page; env vars
# here only pre-fill them so you don't have to paste them in by hand.
CHPP_CONSUMER_KEY=
CHPP_CONSUMER_SECRET=

# CHPP's OAuth flow is "out-of-band" (oob) — Hattrick shows the user a
# verification code on its own site rather than redirecting to a callback
# URL, so no APP_BASE_URL/callback config is needed here.
